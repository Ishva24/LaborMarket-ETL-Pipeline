  <worksheets>
    <worksheet name='KPI Metrics'>
      <table>
        <view>
          <datasources>
            <datasource caption='Labor Market Analytics (PostgreSQL)' name='federated.labor_market_ds' />
          </datasources>
          <datasource-dependencies datasource='federated.labor_market_ds'>
            <column datatype='string' name='[job_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='175' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <style>
              <style-rule element='pane'>
                <format attr='minwidth' value='-1' />
                <format attr='maxwidth' value='-1' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.labor_market_ds].[job_id]</rows>
        <cols />
      </table>
      <simple-id uuid='{44D9DF10-C3EA-4CEB-BC4F-F46E64C8C578}' />
    </worksheet>
    <worksheet name='Salary Ranges'>
      <table>
