  <datasources>
    <datasource caption='Labor Market Analytics (PostgreSQL)' inline='true' name='federated.labor_market_ds' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='localhost' name='postgres_connection'>
            <connection authentication='username-password' class='postgres' dbname='labor_market' odbc-native-protocol='' one-time-sql='' port='5432' server='localhost' username='admin_user' />
          </named-connection>
        </named-connections>
        <relation connection='postgres_connection' name='Custom SQL Query' type='text'>SELECT 
              j.job_id,
              j.job_title,
              c.company_name,
              l.city,
              l.state,
              l.country,
              j.posted_date,
              j.salary_min,
              j.salary_max,
              j.salary_midpoint,
              j.currency,
              j.work_type,
              s.skill_name,
              s.skill_category
          FROM analytics.fct_jobs j
          LEFT JOIN analytics.dim_companies c ON j.company_key = c.company_key
          LEFT JOIN analytics.dim_locations l ON j.location_key = l.location_key
          LEFT JOIN analytics.bridge_job_skills b ON j.job_key = b.job_key
          LEFT JOIN analytics.dim_skills s ON b.skill_key = s.skill_key</relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>job_id</remote-name>
            <remote-type>130</remote-type>
            <local-name>[job_id]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>job_id</remote-alias>
            <ordinal>1</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <width>100</width>
            <contains-null>true</contains-null>
            <collation flag='0' name='LEN_RUS' />
            <attributes>
              <attribute datatype='string' name='DebugRemoteType'>&quot;SQL_WVARCHAR&quot;</attribute>
              <attribute datatype='string' name='DebugWireType'>&quot;SQL_C_WCHAR&quot;</attribute>
              <attribute datatype='string' name='TypeIsVarchar'>&quot;true&quot;</attribute>
            </attributes>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>job_title</remote-name>
